#!/bin/bash
# Pre-push hook: Run impacted tests before pushing to origin
#
# Determines which tests are impacted by changed files and runs them locally
# via the all-in-one Docker image. Can be bypassed with --no-verify.
#
# Maps each changed file to a Cest class. Files that match shared infrastructure
# trigger a full acceptance test suite run.

set -e

# Every container invocation goes through bin/test, which forwards the calling
# user and group to the container, mounts the git common dir for worktrees and
# persists the Composer cache. Image selection is bin/test's too, through
# AZTEC_TEST_IMAGE (a full image reference — see README).
TEST="$(git rev-parse --show-toplevel)/bin/test"

# Determine changed files
# First, try to get files since tracking branch (most common case)
if git merge-base --is-ancestor @{push} HEAD 2>/dev/null; then
    CHANGED_FILES=$(git diff --name-only @{push}..HEAD)
elif [ -n "$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)" ]; then
    CHANGED_FILES=$(git diff --name-only @{u}...HEAD)
else
    # Fallback: compare to origin/main
    CHANGED_FILES=$(git diff --name-only origin/main...HEAD)
fi

# If no changed files detected, abort — something is off with the git state
if [ -z "$CHANGED_FILES" ]; then
    echo "No changed files detected; aborting push. Use --no-verify to bypass." >&2
    exit 1
fi

# Skip tests if no PHP files were changed
PHP_CHANGED=$(echo "$CHANGED_FILES" | grep '\.php$' || true)
if [ -z "$PHP_CHANGED" ]; then
    echo "No PHP files changed; skipping tests."
    exit 0
fi

# Map changed files to Cest classes
declare -a CESTS
RUN_ALL=0

for file in $CHANGED_FILES; do
    case "$file" in
        src/Method/CartMethods.php)
            CESTS+=("CartCest")
            ;;
        src/Method/CheckoutMethods.php)
            CESTS+=("CheckoutCest")
            ;;
        src/Method/CouponMethods.php)
            CESTS+=("CouponCest")
            ;;
        src/Method/CustomerMethods.php)
            CESTS+=("CustomerCest")
            ;;
        src/Method/OrderMethods.php)
            CESTS+=("OrderCest")
            ;;
        src/Method/ProductMethods.php)
            CESTS+=("ProductCest")
            ;;
        # Shared infrastructure: triggers full suite
        src/aliases.php|src/AztecWPBrowser.php|src/Config/*|src/Page/*|src/OrderStorage/*|src/Storage/*|src/SubscriptionStorage/*|composer.json|composer.lock|phpstan.neon.dist|phpcs.xml.dist|tests/_support/*|tests/acceptance/*)
            RUN_ALL=1
            break
            ;;
    esac
done

# Remove duplicates from Cests array
if [ $RUN_ALL -eq 0 ] && [ ${#CESTS[@]} -gt 0 ]; then
    CESTS=($(printf '%s\n' "${CESTS[@]}" | sort -u))
fi

# Install dependencies and bootstrap test site
#
# `composer install`, never `update`: the hook is a verification gate, so it must
# run against the locked versions and leave composer.lock untouched in the
# working tree of whoever is pushing.
echo "Installing dependencies and bootstrapping test site..."
"$TEST" bash -c "composer install && bash resources/install.sh"

# Run tests
if [ $RUN_ALL -eq 1 ] || [ ${#CESTS[@]} -eq 0 ]; then
    echo "Running full test suite..."
    "$TEST" codecept run
else
    echo "Running impacted tests: ${CESTS[*]} + unit"
    # `codecept run` only accepts a single optional "test" argument, so passing
    # multiple Cest names positionally fails once we have 2+ impacted classes.
    # Use --filter instead: it matches against the test signature
    # (`FQCN:testMethod` for a Cest), so the trailing `:` anchors the match to
    # the class boundary and avoids collisions between similarly named Cests.
    FILTER="($(IFS='|'; printf '%s' "${CESTS[*]}")):"
    "$TEST" bash -c "codecept run acceptance --filter '$FILTER' && codecept run unit"
fi
