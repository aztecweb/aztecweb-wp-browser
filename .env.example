# Defaults used when running the test image. Override per environment.

# WordPress (served by Codeception BuiltInServerController)
WP_URL=http://localhost:8080
WP_HOME=http://localhost:8080
WP_DOCROOT=public
WP_SERVER_PORT=8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password
WP_ADMIN_EMAIL=admin@example.com

# SQLite database (sqlite-database-integration drop-in)
DB_PATH=public/packages/database/.ht.sqlite
DB_TABLE_PREFIX=wp_

# Chromedriver (managed by ChromeDriverController)
CHROMEDRIVER_HOST=localhost
CHROMEDRIVER_PORT=9515
CHROMEDRIVER_BINARY=/usr/lib/chromium/chromedriver
